---
// The hero portrait. With a real photo (profile.portrait + file in src/assets/) it is shown in
// monochrome, cropped to the box; until then the design's crop-marked placeholder is shown.
import { Image } from 'astro:assets';
import { profile } from '../../data/profile';
import { getImage } from '../../utils/images';
import { SHOW_PLACEHOLDERS } from '../../utils/placeholders';

const photo = getImage(profile.portrait?.src);
---

{
  photo ? (
    <Image
      class="photo"
      src={photo}
      alt={profile.portrait?.alt ?? profile.name}
      widths={[236, 472, 420, 840]}
      sizes="(min-width: 1200px) 420px, 236px"
      loading="eager"
      fetchpriority="high"
    />
  ) : (
    <div class="slot" role="img" aria-label={`Portrait of ${profile.name}`}>
      <svg class="cross" width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 0L100 100M100 0L0 100" stroke="#9AA3B2" stroke-width="1" vector-effect="non-scaling-stroke" fill="none"></path>
      </svg>
      <span class="mark mark-left" aria-hidden="true"></span>
      <span class="mark mark-right" aria-hidden="true"></span>
      <div class="note">
        <strong>PORTRAIT — {profile.name.toUpperCase()}</strong>
        {
          SHOW_PLACEHOLDERS && (
            <>
              <br />[REAL PHOTO TO BE ADDED<span class="on-wide"> · BACKGROUND REMOVED</span>]
              <br />grayscale(100%) contrast(115%)
            </>
          )
        }
      </div>
    </div>
  )
}

<style>
  .photo,
  .slot {
    display: block;
    width: 100%;
    height: 100%;
  }
  .photo {
    object-fit: cover;
    object-position: 50% 20%;
    /* monochrome treatment from the design */
    filter: grayscale(100%) contrast(115%);
  }
  .slot {
    position: relative;
    overflow: hidden;
    background: #dadfe6;
  }
  .cross {
    position: absolute;
    inset: 0;
  }
  .mark {
    position: absolute;
    top: 10px;
    width: 16px;
    height: 16px;
    border-top: 2px solid var(--color-ink);
  }
  .mark-left {
    left: 10px;
    border-left: 2px solid var(--color-ink);
  }
  .mark-right {
    right: 10px;
    border-right: 2px solid var(--color-ink);
  }
  .note {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 10px 12px;
    background: #fff;
    border-top: 1px solid var(--wire-line);
    color: var(--wire-note);
    font-family: var(--font-mono);
    font-size: 10.5px;
    line-height: 1.5;
  }
  .note strong {
    font-weight: 500;
    color: var(--color-ink);
  }

  @media (min-width: 1200px) {
    .mark {
      top: 12px;
      width: 18px;
      height: 18px;
    }
    .mark-left {
      left: 12px;
    }
    .mark-right {
      right: 12px;
    }
    .note {
      padding: 12px 16px;
      font-size: 11px;
    }
  }
</style>
