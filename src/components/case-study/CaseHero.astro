---
// Case-study hero: breadcrumb, giant number + accent field + screenshot, title, and a metadata strip.
// One DOM; desktop = architectural grid, mobile = rail layout with an "At a glance" list.
import { projects } from '../../data/projects';
import type { Project } from '../../data/types';
import { accentOf, accentStyle } from '../../utils/accent';
import { getImage } from '../../utils/images';
import { SHOW_PLACEHOLDERS } from '../../utils/placeholders';
import GoLink from '../ui/GoLink.astro';
import ProjectShot from '../projects/ProjectShot.astro';

interface Props {
  project: Project;
  /** Id of the first section, for the "jump" arrow. */
  firstSectionId: string;
}

const { project, firstSectionId } = Astro.props;
const accent = accentOf(project.accent);
const total = String(projects.length).padStart(2, '0');
const cover = getImage(project.cover?.src);
const showRole = Boolean(project.role) || SHOW_PLACEHOLDERS;
// Projects are not deployed. They are presented through pinned screenshots and the source repository.
const presentedAs = project.inDevelopment ? 'In development' : 'Screenshots and source';
const repo =
  project.repository.visibility === 'private'
    ? 'Private'
    : project.repository.url
      ? 'Public'
      : SHOW_PLACEHOLDERS
        ? 'Public'
        : undefined;
---

<div class="hero" style={accentStyle(project.accent)}>
  <!-- breadcrumb + kind -->
  <div class="crumbs-row">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol class="lbl">
        <li><a href="/#projects">Projects</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page">{project.shortTitle}</li>
      </ol>
    </nav>
    <div class="kind">
      <p class="lbl">Case study · {project.number} / {total}</p>
      {SHOW_PLACEHOLDERS && <p class="kind-tag"><span class="tag">Template</span></p>}
    </div>
  </div>

  <!-- visual -->
  <div class="visual">
    <div class="field" aria-hidden="true"></div>
    <div class="shot-slot">
      <ProjectShot
        drawing="case-hero"
        image={cover}
        fit={project.cover?.fit}
        alt={project.cover?.alt ?? project.title}
        caption={SHOW_PLACEHOLDERS ? '[SCREENSHOT PLACEHOLDER — hero image]' : `${project.shortTitle} — interface schematic`}
        label={SHOW_PLACEHOLDERS ? `Placeholder for a ${project.shortTitle} screenshot — to be added` : `Interface schematic of ${project.title}`}
      />
    </div>
    <div class="numwrap" aria-hidden="true">
      <span class="sq"></span>
      <span class="num">{project.number}</span>
    </div>
  </div>

  <!-- title and metadata -->
  <div class="titlebar">
    <div class="titles">
      <h1 class:list={['title', 'disp', { 'title-long': project.title.length > 16 }]}>
        {project.title}<span class="sr"> — case study</span>
      </h1>
      <p class="subtitle">{project.subtitle}</p>
      {
        SHOW_PLACEHOLDERS && (
          <p class="draft">
            <span class="ph">[TEMPLATE — COPY DRAFTED FROM THE PROJECT BRIEF; REVIEW BEFORE PUBLISHING]</span>
          </p>
        )
      }
    </div>

    <div class="rule rule-1" aria-hidden="true"></div>
    <div class="rule rule-2" aria-hidden="true"></div>
    <div class="rail" aria-hidden="true"><span class="rail-text lbl">At a glance</span></div>

    {
      project.status && (
        <div class="status">
          <p class="lbl mute">Status</p>
          <p class="value">{project.status}</p>
        </div>
      )
    }
    <div class="meta-grid">
      {
        showRole && (
          <div class="meta">
            <p class="lbl mute">My role</p>
            <p class="value">{project.role ?? <span class="ph">[TO BE FILLED]</span>}</p>
          </div>
        )
      }
      {
        repo && (
          <div class="meta">
            <p class="lbl mute">Repository</p>
            <p class="value">{repo}</p>
          </div>
        )
      }
      <div class="meta">
        <p class="lbl mute">Shown as</p>
        <p class="value">{presentedAs}</p>
      </div>
    </div>
    <div class="canonical">
      <div class="meta">
        <p class="lbl mute">Canonical URL</p>
        <p class="url">igorkadziela.dev/projects/{project.slug}</p>
      </div>
    </div>
    <div class="go-cell">
      <GoLink href={`#${firstSectionId}`} label="Jump to the project overview" direction="down" fill={accent.color} ink={accent.on} size={30} />
    </div>
  </div>
</div>

<style>
  /* =====================================================================
     Mobile + tablet
     ===================================================================== */
  .hero {
    position: relative;
    z-index: 1;
  }
  .crumbs-row {
    position: relative;
    z-index: 2;
    height: 56px;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
  }
  .crumbs {
    grid-column: 2;
  }
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0 10px;
    align-items: center;
    align-content: center;
    height: 100%;
    padding: 0 20px;
  }
  .crumbs a {
    display: inline-block;
    padding: 12px 0;
  }
  /* the kind label is drawn on top of the number band */
  .kind {
    position: absolute;
    left: calc(var(--rail) + 20px);
    /* lifted while the number's ink would cover it (narrow phones); 20px below the band top from tablet up */
    top: calc(57px + max(0px, min(20px, calc(38.6 * var(--m) - 36px))));
  }
  .kind-tag {
    margin-top: 6px;
  }

  .visual {
    position: relative;
    /* above the next row, so its hairline does not run through the screenshot caption */
    z-index: 2;
    height: calc(480 * var(--m));
    border-top: 1px solid var(--color-grid);
  }
  .field {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(230 * var(--m) - 1px);
    height: calc(250 * var(--m));
    background: var(--acc);
  }
  .shot-slot {
    position: absolute;
    z-index: 2;
    left: calc(var(--rail) - 20px);
    width: calc(100% - var(--rail));
    top: calc(256 * var(--m) - 1px);
    height: calc(244 * var(--m));
  }
  .numwrap {
    position: absolute;
    z-index: 3;
    left: 10px;
    top: calc(53.6 * var(--m) - 1px);
  }
  .num {
    position: relative;
    display: block;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: calc(240 * var(--m));
    line-height: 0.76;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }
  .sq {
    position: absolute;
    left: calc(4 * var(--m));
    bottom: calc(12 * var(--m));
    width: calc(78 * var(--m));
    height: calc(78 * var(--m));
    background: var(--acc);
  }

  .titlebar {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
  }
  .titles {
    grid-column: 1 / 3;
    grid-row: 1;
    padding: 50px 20px 28px;
    container-type: inline-size;
  }
  .title {
    font-size: min(calc(42 * var(--m)), calc((100cqw - 40px) / 7.9));
  }
  /* Long Polish title: wrap on word boundaries, sized so three lines fit the column at 320px. */
  .title-long {
    white-space: normal;
    font-size: min(calc(42 * var(--m)), calc(100cqi / 8.7));
  }
  .subtitle {
    margin-top: 16px;
    font-size: 18px;
    line-height: 1.45;
    font-weight: 500;
  }
  .draft {
    margin-top: 16px;
  }
  .rule,
  .go-cell {
    display: none;
  }
  .rail {
    grid-column: 1;
    grid-row: 2 / 5;
    display: flex;
    justify-content: center;
    padding-top: 28px;
    border-top: 1px solid var(--color-grid);
  }
  .rail-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    color: var(--color-mute);
  }
  .status {
    grid-column: 2;
    grid-row: 2;
    padding: 26px 20px 13px;
    border-top: 1px solid var(--color-grid);
  }
  .meta-grid {
    grid-column: 2;
    grid-row: 3;
    padding: 0 20px;
  }
  .canonical {
    grid-column: 2;
    grid-row: 4;
    padding: 0 20px 30px;
  }
  .meta {
    padding: 13px 0;
    border-top: 1px solid var(--color-grid);
  }
  .canonical .meta {
    border-bottom: 1px solid var(--color-grid);
  }
  .value {
    margin-top: 4px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }
  .url {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.4;
    word-break: break-all;
  }
  .meta :global(.ph),
  .status :global(.ph) {
    font-size: 12px;
  }

  /* =====================================================================
     Desktop (design: 1360px site)
     ===================================================================== */
  @media (min-width: 1200px) {
    .crumbs-row {
      height: calc(72 * var(--u));
      grid-template-columns: var(--cols);
    }
    .crumbs {
      grid-column: 1 / 3;
      display: flex;
      align-items: center;
      padding: 0 calc(44 * var(--u));
    }
    .crumbs ol {
      padding: 0;
    }
    .crumbs a {
      padding: 10px 0;
    }
    .kind {
      position: static;
      grid-column: 3;
      display: flex;
      align-items: center;
      padding: 0 calc(44 * var(--u));
    }
    .kind-tag {
      display: none;
    }

    .visual {
      height: calc(420 * var(--u));
    }
    .field {
      top: 0;
      bottom: 0;
      height: auto;
      left: 35.057%;
    }
    .shot-slot {
      top: calc(48 * var(--u));
      left: calc(35.057% + 56 * var(--u));
      width: calc(620 * var(--u));
      height: calc(400 * var(--u));
    }
    .numwrap {
      left: calc(20 * var(--u));
      top: auto;
      bottom: calc(-8 * var(--u));
    }
    .num {
      font-size: calc(320 * var(--u));
    }
    .sq {
      left: calc(6 * var(--u));
      bottom: calc(16 * var(--u));
      width: calc(104 * var(--u));
      height: calc(104 * var(--u));
      transition: transform 0.3s var(--ease);
    }
    .hero:hover .sq {
      transform: translate(10px, -10px);
    }

    .titlebar {
      grid-template-columns: var(--cols);
      grid-template-rows: auto auto;
    }
    .titles {
      grid-column: 3 / 5;
      grid-row: 1;
      padding: calc(52 * var(--u) + 1px) calc(44 * var(--u)) calc(40 * var(--u));
    }
    .title {
      font-size: calc(84 * var(--u));
      white-space: normal;
    }
    .title-long {
      /* Longest word has to stay inside the title column at every desktop width. */
      font-size: min(calc(84 * var(--u)), calc(100cqi / 8.3));
    }
    .subtitle {
      max-width: calc(600 * var(--u));
      margin-top: 18px;
      font-size: max(16px, calc(20 * var(--u)));
    }
    .draft {
      margin-top: 20px;
    }
    .rule {
      display: block;
      grid-column: 1 / -1;
      height: 1px;
      align-self: start;
      background: var(--color-grid);
    }
    .rule-1 {
      grid-row: 1;
    }
    .rule-2 {
      grid-row: 2;
    }
    .rail {
      display: none;
    }
    .status {
      grid-column: 1;
      grid-row: 1;
      padding: calc(44 * var(--u) + 1px) calc(44 * var(--u)) calc(44 * var(--u));
      border-top: 0;
    }
    .canonical {
      grid-column: 1;
      grid-row: 2;
      padding: calc(30 * var(--u) + 1px) calc(44 * var(--u)) calc(30 * var(--u));
    }
    .meta,
    .canonical .meta {
      padding: 0;
      border: 0;
    }
    .url {
      margin-top: 6px;
      font-size: 11.5px;
      line-height: 1.55;
    }
    .meta-grid {
      grid-column: 3 / 5;
      grid-row: 2;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      padding: calc(30 * var(--u) + 1px) calc(44 * var(--u)) calc(30 * var(--u));
    }
    .value {
      margin-top: 6px;
      line-height: 1.55;
    }
    .status .value {
      margin-top: 4px;
    }
    .go-cell {
      display: grid;
      grid-column: 5;
      grid-row: 2;
      padding-top: 1px;
    }
  }
</style>
