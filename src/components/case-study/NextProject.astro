---
// Moves on to the next project (wrapping around) or back to the overview.
import { projects } from '../../data/projects';
import { accentOf } from '../../utils/accent';
import Icon from '../ui/Icon.astro';

interface Props {
  index: number;
}

const { index } = Astro.props;
const next = projects[(index + 1) % projects.length];
const accent = accentOf(next.accent);
const total = String(projects.length).padStart(2, '0');
---

<nav class="next" aria-label="More projects">
  <a class="nx up" href={`/projects/${next.slug}`} aria-label={`Next project: ${next.title}`} style={`--bg:${accent.color};--fg:${accent.on}`}>
    <span class="lbl">Next project · {next.number} / {total}</span>
    <span class="up-row">
      <span class="up-title disp">{next.title}</span>
      <Icon class="up-arrow" name="right" size={36} />
    </span>
  </a>
  <a class="nx all" href="/#projects">
    <span class="lbl">All projects</span>
    <span class="all-title disp">Back to<br />overview</span>
    <Icon class="all-arrow" name="right" size={16} />
  </a>
</nav>

<style>
  /* ---------- mobile ---------- */
  .next {
    position: relative;
    z-index: 1;
  }
  .nx {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: block;
    color: var(--color-ink);
    transition: color 0.2s var(--ease);
  }
  .nx::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .nx:hover::before,
  .nx:focus-visible::before,
  .nx:active::before {
    transform: scaleX(1);
  }
  .nx:hover,
  .nx:focus-visible,
  .nx:active {
    color: #fff;
  }
  .up {
    padding: 30px 20px 32px;
    background: var(--bg);
    color: var(--fg);
    border-top: 1px solid var(--color-grid);
  }
  .up-title {
    display: block;
    margin-top: 34px;
    font-size: 36px;
    line-height: 0.98;
  }
  .up :global(.up-arrow) {
    display: block;
    margin-top: 22px;
  }
  .up-row {
    display: block;
  }
  .all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    padding: 0 20px;
    background: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .all-title {
    display: none;
  }

  /* ---------- tablet ---------- */
  @media (min-width: 768px) {
    .up {
      padding: 44px 40px;
    }
    .up-title {
      font-size: 56px;
    }
  }

  /* ---------- desktop ---------- */
  @media (min-width: 1200px) {
    .next {
      display: grid;
      grid-template-columns: var(--cols);
      min-height: calc(240 * var(--u));
      border-top: 1px solid var(--color-grid);
    }
    .up {
      grid-column: 3 / 6;
      grid-row: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 20px;
      padding: calc(44 * var(--u));
      border-top: 0;
    }
    .up-row {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
    }
    .up-title {
      margin: 0;
      font-size: calc(44 * var(--u));
      text-wrap: balance;
    }
    .up :global(.up-arrow) {
      flex: none;
      width: 40px;
      height: 40px;
      margin: 0;
      transition: transform 0.22s var(--ease);
    }
    .up:hover :global(.up-arrow) {
      transform: translateX(8px);
    }
    .all {
      grid-column: 1;
      grid-row: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
      min-height: 0;
      padding: calc(44 * var(--u));
      background: transparent;
      font-size: 11.5px;
      letter-spacing: 0.16em;
    }
    .all-title {
      display: block;
      font-size: calc(28 * var(--u));
      letter-spacing: 0.005em;
    }
    .all :global(.all-arrow) {
      display: none;
    }
  }
</style>
