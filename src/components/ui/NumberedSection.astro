---
// A numbered content section: big number with an accent bar on the left, heading and content on the right.
// Used by the case-study pages and the resume page.
interface Props {
  id: string;
  number: string;
  title: string;
  /** Tighter heading spacing, for sections that start with a list. */
  tight?: boolean;
  /** Inline custom properties (--acc, --on, --soft) for the accent. */
  accentStyle?: string;
}

const { id, number, title, tight = false, accentStyle } = Astro.props;
---

<section id={id} class="cs" aria-labelledby={`${id}-title`} style={accentStyle}>
  <div class="num-cell">
    <span class="n disp">{number}</span>
    <span class="bar"></span>
  </div>
  <div class="main">
    <h2 id={`${id}-title`} class:list={['cs-title', 'disp', { tight }]}>{title}</h2>
    <slot />
  </div>
</section>

<style>
  /* ---------- mobile + tablet: rail with the number | content ---------- */
  .cs {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    border-top: 1px solid var(--color-grid);
  }
  .num-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding-top: 30px;
  }
  .n {
    font-size: 22px;
    line-height: 1;
  }
  .bar {
    display: block;
    width: 22px;
    height: 5px;
    background: var(--acc, var(--color-ink));
  }
  .main {
    min-width: 0;
    padding: 28px 20px 30px;
  }
  .cs-title {
    margin-bottom: 18px;
    font-size: 30px;
  }
  .cs-title.tight {
    margin-bottom: 12px;
  }

  @media (min-width: 768px) {
    .main {
      max-width: 820px;
    }
  }

  /* ---------- desktop: number in column A, content in column C ---------- */
  @media (min-width: 1200px) {
    .cs {
      grid-template-columns: var(--cols);
    }
    .num-cell {
      display: block;
      padding: calc(44 * var(--u));
    }
    .n {
      font-size: calc(64 * var(--u));
      line-height: 0.92;
    }
    .bar {
      width: 28px;
      height: 6px;
      margin-top: 14px;
    }
    .main {
      grid-column: 3 / 5;
      max-width: none;
      padding: calc(44 * var(--u));
    }
    .cs-title,
    .cs-title.tight {
      margin-bottom: 22px;
      font-size: calc(34 * var(--u));
    }
  }
</style>
