---
// Contact. The section always shows its rows (Open to, Email, LinkedIn, GitHub). Until a value is set in
// src/data/profile.ts, a row shows the design's placeholder text; once set, the real value and link replace it.
import { profile } from '../../data/profile';
import { SHOW_PLACEHOLDERS } from '../../utils/placeholders';
import Icon from '../ui/Icon.astro';

const channels = [
  { label: 'Email', value: profile.email, href: profile.email ? `mailto:${profile.email}` : '#contact', text: profile.email, placeholder: '[EMAIL ADDRESS — TO BE FILLED]' },
  { label: 'Phone', value: profile.phone, href: profile.phone ? `tel:${profile.phone.replace(/\s/g, '')}` : '#contact', text: profile.phone, placeholder: '[PHONE NUMBER — TO BE FILLED]' },
  { label: 'LinkedIn', value: profile.linkedin, href: profile.linkedin ?? '#contact', text: profile.linkedin?.replace(/^https?:\/\/(www\.)?/, ''), placeholder: '[PROFILE URL — TO BE FILLED]' },
  { label: 'GitHub', value: profile.github, href: profile.github ?? '#contact', text: profile.github?.replace(/^https?:\/\/(www\.)?/, ''), placeholder: '[PROFILE URL — TO BE FILLED]' },
];
---

<section id="contact" class="contact" aria-labelledby="contact-title">
  <div class="rail" aria-hidden="true"><span class="rail-text lbl">Get in touch</span></div>
  <div class="heading">
    <h2 id="contact-title" class="title disp">Contact</h2>
    <div class="squares" aria-hidden="true"><span class="blue" /><span class="red" /><span class="yellow" /></div>
  </div>
  <div class="channels">
    <p class="lbl">Open to</p>
    <p class="open">
      {profile.availability ?? <span class="ph">[ROLE / INTERNSHIP / JUNIOR / FULL-TIME — TO BE FILLED]</span>}
    </p>
    {profile.workMode && <p class="open-note">{profile.workMode}</p>}
    <ul class="list">
      {
        channels.map((channel, index) => (
          <li>
            <a
              class:list={['channel', { last: index === channels.length - 1 }]}
              href={channel.href}
              rel={channel.value ? 'me noopener' : undefined}
            >
              <span class="channel-text">
                <span class="channel-label">{channel.label}</span>
                {channel.text ??
                  (SHOW_PLACEHOLDERS ? <span class="ph">{channel.placeholder}</span> : <span class="soon">Coming soon</span>)}
              </span>
              <Icon name="right" size={16} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="yellow-block" aria-hidden="true"></div>
  <div class="bar" aria-hidden="true"><span class="blue" /><span class="red" /><span class="yellow" /></div>
</section>

<style>
  /* ---------- mobile ---------- */
  .contact {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    /* Tall enough that #contact and the section above it can scroll to the viewport top. */
    grid-template-rows: auto minmax(0, 1fr) auto;
    min-height: 100dvh;
    border-top: 1px solid var(--color-grid);
  }
  .rail {
    grid-column: 1;
    display: flex;
    justify-content: center;
    padding-top: 28px;
  }
  .rail-text {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
    color: var(--color-mute);
  }
  .heading {
    display: contents;
  }
  .title {
    grid-column: 2;
    grid-row: 1;
    padding: 36px 20px 0;
    font-size: 40px;
  }
  .squares {
    display: none;
  }
  .channels {
    grid-column: 2;
    grid-row: 2;
    padding: 22px 20px 30px;
  }
  .rail {
    grid-row: 1 / 3;
  }
  .open {
    margin-top: 8px;
  }
  .open-note {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.45;
    color: var(--color-mute);
  }
  .soon {
    color: var(--color-mute);
  }
  .list {
    margin-top: 26px;
  }
  .channel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    padding: 14px 0;
    border-top: 1px solid var(--color-grid);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .channel.last {
    border-bottom: 1px solid var(--color-grid);
  }
  .channel :global(.ph) {
    font-size: 10.5px;
  }
  .channel-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .channel :global(svg) {
    display: none;
  }
  .yellow-block {
    display: none;
  }
  .bar {
    grid-column: 1 / 3;
    grid-row: 3;
    align-self: end;
    display: flex;
    height: 56px;
  }
  .bar span {
    flex: 1;
  }
  .blue {
    background: var(--color-blue);
  }
  .red {
    background: var(--color-red);
  }
  .yellow {
    background: var(--color-yellow);
  }

  /* ---------- tablet ---------- */
  @media (min-width: 768px) {
    .channels {
      max-width: 640px;
    }
  }

  /* ---------- desktop ---------- */
  @media (min-width: 1200px) {
    .contact {
      grid-template-columns: var(--cols);
      grid-template-rows: auto minmax(0, 1fr);
      /* Undo .site zoom so the section is one viewport tall, then the footer still follows. */
      min-height: max(calc(440 * var(--u)), calc(var(--viewport-h) / var(--zoom-ratio) + 8px));
    }
    .rail {
      display: none;
    }
    .heading {
      grid-column: 1;
      grid-row: 1;
      align-self: start;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-height: calc(440 * var(--u));
      padding: calc(44 * var(--u));
    }
    .title {
      padding: 0;
      font-size: calc(44 * var(--u));
    }
    .squares {
      display: flex;
    }
    .squares span {
      width: calc(44 * var(--u));
      height: calc(44 * var(--u));
    }
    .channels {
      grid-column: 3 / 5;
      grid-row: 1;
      align-self: start;
      max-width: none;
      padding: calc(44 * var(--u));
    }
    .open {
      margin-top: 10px;
      font-size: max(17px, calc(22 * var(--u)));
      font-weight: 600;
      line-height: 1.35;
    }
    .open :global(.ph) {
      font-size: 14px;
    }
    .open-note {
      margin-top: 8px;
      font-size: max(14px, calc(16 * var(--u)));
    }
    .list {
      margin-top: 36px;
    }
    .channel {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 22px 0;
      font-size: max(11.5px, calc(13 * var(--u)));
    }
    .channel::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -1px;
      width: 100%;
      height: 2px;
      background: var(--color-ink);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s var(--ease);
    }
    .channel:hover::after,
    .channel:focus-visible::after {
      transform: scaleX(1);
    }
    .channel-text {
      flex-direction: row;
      align-items: baseline;
      gap: 28px;
    }
    .channel-label {
      width: 96px;
    }
    .channel :global(svg) {
      display: block;
      flex: none;
      transition: transform 0.2s var(--ease);
    }
    .channel:hover :global(svg) {
      transform: translateX(5px);
    }
    .yellow-block {
      display: block;
      grid-column: 5;
      grid-row: 1 / -1;
      align-self: end;
      height: calc(72 * var(--u));
      background: var(--color-yellow);
    }
    .bar {
      display: none;
    }
  }
</style>
