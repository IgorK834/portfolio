---
// Resume call-to-action: a solid ink block, a PDF download (once the file exists) and the HTML resume.
import { profile } from '../../data/profile';
import { SHOW_PLACEHOLDERS } from '../../utils/placeholders';
import { hasResumePdf } from '../../utils/resume';
import Icon from '../ui/Icon.astro';

const showPdf = hasResumePdf || SHOW_PLACEHOLDERS;
---

<section id="resume" class="resume" aria-labelledby="resume-title">
  <div class="block">
    <p class="kind lbl">PDF · HTML</p>
    <h2 id="resume-title" class="title disp">Resume</h2>
  </div>
  <div class="content">
    <p class="intro">{profile.copy.resumeIntro}</p>
    <div class="actions">
      {
        showPdf && (
          <a
            class="btn btn-blue"
            href={hasResumePdf ? profile.resumeUrl : '/resume'}
            download={hasResumePdf ? '' : undefined}
            aria-label="Download CV as PDF"
          >
            <span>Download CV (PDF)</span>
            <Icon name="down" size={16} />
          </a>
        )
      }
      <a class="btn btn-line" href="/resume" aria-label="Open the HTML resume">
        <span>HTML resume /resume</span>
        <Icon name="right" size={16} />
      </a>
      {
        !hasResumePdf && SHOW_PLACEHOLDERS && (
          <p class="note">
            <span class="ph">[CV PDF — FILE TO BE ADDED]</span>
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  /* ---------- mobile ---------- */
  .resume {
    position: relative;
    z-index: 1;
    padding: 40px 20px;
    background: var(--color-ink);
    color: #fff;
  }
  .kind {
    color: #c3cad6;
  }
  .title {
    margin-top: 20px;
    font-size: 64px;
  }
  .intro {
    margin-top: 18px;
    color: #e6eaf0;
    font-size: 17px;
    line-height: 1.5;
  }
  .actions {
    display: grid;
    gap: 12px;
    margin-top: 26px;
  }
  .note {
    margin-top: 4px;
  }
  .note :global(.ph) {
    color: #e6eaf0;
    border-color: #8d96a6;
  }
  .btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    min-height: 54px;
    padding: 0 18px;
    border: 2px solid #fff;
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .btn-blue {
    background: var(--color-blue);
    border-color: var(--color-blue);
  }

  /* ---------- tablet ---------- */
  @media (min-width: 768px) {
    .resume {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
      gap: 40px;
      padding: 48px 40px;
    }
    .block {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      min-width: 0;
      container-type: inline-size;
    }
    .title {
      min-width: 0;
      font-size: min(88px, calc(100cqi / 3.95));
      white-space: nowrap;
    }
    .content {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 28px;
    }
    .intro {
      margin: 0;
    }
    .actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 16px;
      margin: 0;
    }
    .btn {
      gap: 14px;
      min-height: 0;
      padding: 16px 20px;
      transition:
        background 0.2s var(--ease),
        color 0.2s var(--ease),
        border-color 0.2s var(--ease);
    }
    .btn :global(svg) {
      transition: transform 0.2s var(--ease);
    }
    .btn:hover :global(svg) {
      transform: translateX(5px);
    }
    .btn-blue:hover {
      background: #fff;
      border-color: #fff;
      color: var(--color-ink);
    }
    .btn-line:hover {
      background: #fff;
      color: var(--color-ink);
    }
  }

  /* ---------- desktop: ink block spans the first two columns, text sits on white ---------- */
  @media (min-width: 1200px) {
    .resume {
      grid-template-columns: var(--cols);
      gap: 0;
      min-height: calc(300 * var(--u));
      padding: 0;
      background: transparent;
      color: var(--color-ink);
      border-top: 1px solid var(--color-grid);
    }
    .block {
      grid-column: 1 / 3;
      padding: calc(44 * var(--u));
      background: var(--color-ink);
      color: #fff;
    }
    .title {
      margin: 0;
      font-size: calc(88 * var(--u));
    }
    .content {
      grid-column: 3 / 5;
      padding: calc(44 * var(--u));
    }
    .intro {
      max-width: calc(560 * var(--u));
      color: var(--color-ink);
      font-size: max(15px, calc(19 * var(--u)));
    }
    .btn {
      border-color: var(--color-ink);
      color: var(--color-ink);
    }
    .btn-blue {
      background: var(--color-blue);
      border-color: var(--color-blue);
      color: #fff;
    }
    .btn-blue:hover {
      background: var(--color-ink);
      border-color: var(--color-ink);
      color: #fff;
    }
    .btn-line:hover {
      background: var(--color-ink);
      color: #fff;
    }
    .note {
      margin: 0;
    }
    .note :global(.ph) {
      color: var(--wire-note);
    }
  }
</style>
