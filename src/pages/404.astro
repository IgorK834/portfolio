---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---

<BaseLayout title="Page not found — Igor Kadziela" description="This page does not exist." path="/404" noindex>
  <section class="nf" aria-labelledby="nf-title">
    <p class="num disp" aria-hidden="true"><span class="sq"></span>404</p>
    <div class="text">
      <h1 id="nf-title" class="title disp">Page not found</h1>
      <p class="lead">The page you are looking for does not exist or has moved.</p>
      <ul class="links">
        <li><a class="btn btn-blue" href="/">Back to home</a></li>
        {projects.map((project) => <li><a class="btn" href={`/projects/${project.slug}`}>{project.title}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    border-top: 1px solid var(--color-grid);
    min-height: 520px;
  }
  .num {
    position: relative;
    grid-column: 1 / 3;
    grid-row: 1;
    align-self: end;
    z-index: 2;
    margin-left: 10px;
    font-size: calc(170 * var(--m));
    line-height: 0.76;
    letter-spacing: -0.03em;
    overflow: visible;
    height: calc(140 * var(--m));
  }
  .sq {
    position: absolute;
    left: 4px;
    bottom: 10px;
    z-index: -1;
    width: calc(64 * var(--m));
    height: calc(64 * var(--m));
    background: var(--color-red);
  }
  .text {
    grid-column: 2;
    grid-row: 2;
    padding: 40px 20px 48px;
  }
  .title {
    font-size: calc(40 * var(--m));
  }
  .lead {
    margin-top: 16px;
    font-size: 18px;
    line-height: 1.5;
  }
  .links {
    display: grid;
    gap: 10px;
    margin-top: 28px;
    max-width: 420px;
  }
  .btn {
    display: flex;
    align-items: center;
    min-height: 52px;
    padding: 0 18px;
    border: 2px solid var(--color-ink);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition:
      background 0.2s var(--ease),
      color 0.2s var(--ease);
  }
  .btn:hover {
    background: var(--color-ink);
    color: #fff;
  }
  .btn-blue {
    background: var(--color-blue);
    border-color: var(--color-blue);
    color: #fff;
  }
  .btn-blue:hover {
    border-color: var(--color-ink);
  }
  @media (min-width: 1200px) {
    .nf {
      grid-template-columns: var(--cols);
      min-height: calc(560 * var(--u));
    }
    .num {
      grid-column: 1 / 3;
      margin-left: calc(20 * var(--u));
      font-size: calc(260 * var(--u));
      height: calc(200 * var(--u));
    }
    .sq {
      width: calc(96 * var(--u));
      height: calc(96 * var(--u));
    }
    .text {
      grid-column: 3 / 5;
      grid-row: 1 / 3;
      align-self: center;
      padding: calc(44 * var(--u));
    }
    .title {
      font-size: calc(84 * var(--u));
    }
  }
</style>
