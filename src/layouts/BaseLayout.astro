---
import { Font } from 'astro:assets';
import '../styles/global.css';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';

interface Props {
  title: string;
  description: string;
  /** Canonical path, e.g. "/projects/researchhub". */
  path: string;
  ogType?: 'website' | 'article';
  /** JSON-LD objects to embed (one script per object). */
  jsonLd?: object[];
  noindex?: boolean;
}

const { title, description, path, ogType = 'website', jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <!-- the design is light-only; stops browsers from auto-darkening it -->
    <meta name="color-scheme" content="light" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Igor Kadziela" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Igor Kadziela — Software Engineer / Full-Stack Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />

    <!-- enables the mobile menu; without JS the navigation is shown as a plain list -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <Font cssVariable="--font-display" preload={[{ weight: 900, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-body" preload={[{ weight: 400, style: 'normal', subset: 'latin' }]} />
    <Font cssVariable="--font-mono" />

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="outer" id="top">
      <div class="site">
        <!-- hairlines of the architectural grid: one rail line on small screens, three column lines on desktop -->
        <div class="gl gl-rail" aria-hidden="true"></div>
        <div class="gl gl-a" aria-hidden="true"></div>
        <div class="gl gl-b" aria-hidden="true"></div>
        <div class="gl gl-c" aria-hidden="true"></div>
        <SiteHeader />
        <main id="main">
          <slot />
        </main>
        <SiteFooter />
      </div>
    </div>
  </body>
</html>

<style>
  .outer {
    /* gives children container-query units (cqw) that exclude the scrollbar */
    container-type: inline-size;
    /* the visible viewport height, resolved outside any zoom (see --viewport-h in global.css) */
    --viewport-h: 100dvh;
  }

  .site {
    /* Desktop composition: drawn at the design's 1360px, so 1 design pixel = --u = 1px. */
    --u: 1px;
    /* Mobile + tablet composition: 1px at the 390px design width, growing with the window up to 1.5px. */
    --m: clamp(0.92px, calc(100cqw / 390), 1.5px);
    --rail: calc(56 * var(--m));
    /* desktop columns: A | B | C (split in two halves) | D, as in the approved grid */
    --cols: minmax(0, 2.05fr) minmax(0, 1fr) minmax(0, 2.335fr) minmax(0, 2.335fr) minmax(0, 0.98fr);

    position: relative;
    max-width: var(--page-max);
    margin: 0 auto;
    background: var(--color-paper);
    overflow-x: clip;
  }
  /* The page is full-bleed. On desktop the whole composition (type, spacing, borders, grid) is scaled
     proportionally to the window width: zoom = window width / 1360px, i.e. a unitless ratio via atan2. */
  @media (min-width: 1200px) {
    .site {
      --zoom-ratio: min(2.5, max(0.9, tan(atan2(100cqw, 1360px))));
      zoom: var(--zoom-ratio);
    }
  }

  .gl {
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 0;
    width: 1px;
    background: var(--color-grid);
    pointer-events: none;
  }
  .gl-rail {
    left: var(--rail);
  }
  .gl-a,
  .gl-b,
  .gl-c {
    display: none;
  }
  @media (min-width: 1200px) {
    .gl-rail {
      display: none;
    }
    .gl-a,
    .gl-b,
    .gl-c {
      display: block;
    }
    .gl-a {
      left: 23.563%;
    }
    .gl-b {
      left: 35.057%;
    }
    .gl-c {
      left: 88.736%;
    }
  }
</style>
